# Generate using: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Initial dashboard account. Set before first launch.
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Each printer joins Tailscale as its own device. Enter that auth key in the dashboard.
# It is used once and is not stored here.
# Email mailbox credentials are configured in the web dashboard, not here.
# Backup only. The selected folder is watched live, and the wait is capped at 5 seconds.
POLL_SECONDS=3
# Optional SNMP v2c community for printer read-only telemetry.
SNMP_COMMUNITY=public
